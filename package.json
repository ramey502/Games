{
  "name": "casual-games-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=20.19" },
  "scripts": {
    "test": "node --import tsx --test tests/*.test.ts",
    "physics:check": "node --import tsx tools/physics-check.ts",
    "typecheck": "node tools/typecheck.mjs",
    "format": "prettier --write games/knockdown/assets/scripts tests tools",
    "format:check": "prettier --check games/knockdown/assets/scripts tests tools",
    "build:web": "node tools/build.mjs web-mobile",
    "build:wechat": "node tools/build.mjs wechatgame",
    "serve": "node tools/serve.mjs"
  },
  "devDependencies": {
    "@cocos/cannon": "1.2.8",
    "@types/node": "22.10.2",
    "prettier": "3.6.2",
    "tsx": "4.20.6",
    "typescript": "5.7.3"
  }
}
